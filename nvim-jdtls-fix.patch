 ---@param cmd_name string
 ---@param code_action_params table
 local function change_signature_prompt(bufnr, signature, cmd_name, code_action_params)
+  if type(signature) ~= "table" then
+    vim.notify("JDT-LS returned no change-signature information", vim.log.levels.ERROR)
+    return
+  end
+  if type(signature.errorMessage) == "string" and signature.errorMessage ~= "" then
+    vim.notify("Cannot change signature: " .. signature.errorMessage, vim.log.levels.ERROR)
+    return
+  end
+  if type(signature.methodIdentifier) ~= "string"
+    or type(signature.modifier) ~= "string"
+    or type(signature.returnType) ~= "string"
+    or type(signature.methodName) ~= "string"
+    or type(signature.parameters) ~= "table"
+    or type(signature.exceptions) ~= "table"
+  then
+    vim.notify("JDT-LS returned incomplete change-signature information", vim.log.levels.ERROR)
+    return
+  end
+
